# Copy this file to .env.local and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser — never put secrets there.

# ── Public site config ────────────────────────────────────────────────────────
# Canonical site URL (no trailing slash). Used for metadata, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://suslicketeam.com

# WhatsApp contact number in international format, digits only (no +).
NEXT_PUBLIC_WHATSAPP_NUMBER=77066998879

# Telegram username for contact links (without the leading @).
NEXT_PUBLIC_TELEGRAM_USERNAME=suslicketeam

# ── Analytics (public) ────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# PostHog project API key (public/ingest key).
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog host. Use https://us.i.posthog.com or https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Web Analytics beacon token.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Yandex Metrika counter ID (digits only, e.g. 109741083). Relevant for the
# Kazakhstan audience (Yandex ~25–28% of KZ search). Consent-gated: the tag only
# loads after the visitor accepts cookies. Leave empty to disable.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ── Server-only secrets (never expose to the client) ──────────────────────────
# Telegram bot token used to deliver lead notifications. Keep secret.
TELEGRAM_BOT_TOKEN=

# Telegram chat/channel ID that lead notifications are sent to.
TELEGRAM_CHAT_ID=

# Webhook URL (e.g. Google Apps Script) that appends leads to a Google Sheet.
LEADS_SHEET_WEBHOOK_URL=
